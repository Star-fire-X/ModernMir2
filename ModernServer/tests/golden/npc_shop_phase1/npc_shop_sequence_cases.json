      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_USERBUYITEM", "ident": 1014, "recog": "npc_id_N", "param": "loword_item_server_index", "tag": "hiword_item_server_index", "series": 0, "body": "Potion"},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_ADDITEM", "ident": 200, "body": "TClientItem(Potion,MakeIndex=new_make_index)"},
        {"seq": 3, "direction": "server_to_client", "actor": "P", "message": "SM_BUYITEM_SUCCESS", "ident": 650, "recog": "P.GoldAfterBuy", "param": "loword_item_server_index", "tag": "hiword_item_server_index", "series": 0, "body": ""}
      ]
    },
    {
      "name": "buy_simple_item_fail_not_enough_gold",
      "preconditions": [
        "N has a simple goods group named Potion",
        "P does not have enough gold"
      ],
      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_USERBUYITEM", "ident": 1014, "recog": "npc_id_N", "param": "loword_item_server_index", "tag": "hiword_item_server_index", "series": 0, "body": "Potion"},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_BUYITEM_FAIL", "ident": 651, "recog": 3, "param": 0, "tag": 0, "series": 0, "body": ""}
