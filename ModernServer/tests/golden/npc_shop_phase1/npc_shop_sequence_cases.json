{
  "schema_version": 1,
  "description": "Expected Delphi NPC and merchant traces derived from Source/M2Server/ObjNpc.pas, Source/M2Server/ObjBase.pas, Source/Client/ClMain.pas, and Source/Client/FState.pas.",
  "actors": {
    "P": "Hero",
    "N": "Shopkeeper"
  },
  "notes": [
    "System message text is intentionally omitted until byte-exact Delphi runtime traces are captured.",
    "NPC ids are Delphi object-pointer values in the original server. C++ must expose stable legacy-compatible handles for these recog fields.",
    "SM_ADDITEM is included as the visible client item-add packet sent by SendAddItem before SM_BUYITEM_SUCCESS.",
    "Weight refresh packets are omitted from the minimum trace until their exact Delphi ordering is verified for each flow."
  ],
  "cases": [
    {
      "name": "click_npc_opens_main_dialog",
      "preconditions": [
        "P is on the same map as N",
        "P is within the 15-tile rectangular interaction range",
        "N has an @main script section"
      ],
      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_CLICKNPC", "ident": 1010, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": ""},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_MERCHANTSAY", "ident": 643, "recog": "npc_id_N", "param": "npc_face", "tag": 0, "series": 0, "body": "Shopkeeper/main dialog text"}
      ]
    },
    {
      "name": "select_buy_opens_goods_list",
      "preconditions": [
        "P has an open dialog with N",
        "N script exposes @buy",
        "N has at least one goods group"
      ],
      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_MERCHANTDLGSELECT", "ident": 1011, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": "@buy"},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_MERCHANTSAY", "ident": 643, "recog": "npc_id_N", "param": "npc_face", "tag": 0, "series": 0, "body": "Shopkeeper/buy dialog text"},
        {"seq": 3, "direction": "server_to_client", "actor": "P", "message": "SM_SENDGOODSLIST", "ident": 645, "recog": "npc_id_N", "param": 1, "tag": 0, "series": 0, "body": "Potion/0/100/12/"}
      ]
    },
    {
      "name": "buy_simple_item_success",
      "preconditions": [
        "N has a simple goods group named Potion",
        "P has enough gold",
        "P can carry and add the item"
