      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_MERCHANTDLGSELECT", "ident": 1011, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": "@repair"},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_SENDUSERREPAIR", "ident": 668, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": ""},
        {"seq": 3, "direction": "client_to_server", "actor": "P", "message": "CM_MERCHANTQUERYREPAIRCOST", "ident": 1024, "recog": "npc_id_N", "param": "loword_make_index", "tag": "hiword_make_index", "series": 0, "body": "Sword"},
        {"seq": 4, "direction": "server_to_client", "actor": "P", "message": "SM_SENDREPAIRCOST", "ident": 671, "recog": "computed_repair_cost", "param": 0, "tag": 0, "series": 0, "body": ""},
        {"seq": 5, "direction": "client_to_server", "actor": "P", "message": "CM_USERREPAIRITEM", "ident": 1023, "recog": "npc_id_N", "param": "loword_make_index", "tag": "hiword_make_index", "series": 0, "body": "Sword"},
        {"seq": 6, "direction": "server_to_client", "actor": "P", "message": "SM_USERREPAIRITEM_OK", "ident": 669, "recog": "P.GoldAfterRepair", "param": "Item.DuraAfterRepair", "tag": "Item.DuraMaxAfterRepair", "series": 0, "body": ""}
      ]
