        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_SENDUSERSELL", "ident": 646, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": ""},
        {"seq": 3, "direction": "client_to_server", "actor": "P", "message": "CM_MERCHANTQUERYSELLPRICE", "ident": 1012, "recog": "npc_id_N", "param": "loword_make_index", "tag": "hiword_make_index", "series": 0, "body": "Sword"},
