      ],
      "trace": [
        {"seq": 1, "direction": "client_to_server", "actor": "P", "message": "CM_MERCHANTDLGSELECT", "ident": 1011, "recog": "npc_id_N", "param": 0, "tag": 0, "series": 0, "body": "@exit"},
        {"seq": 2, "direction": "server_to_client", "actor": "P", "message": "SM_MERCHANTDLGCLOSE", "ident": 644, "recog": 0, "param": 0, "tag": 0, "series": 0, "body": ""}
      ]
