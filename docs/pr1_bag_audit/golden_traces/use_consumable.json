{
  "name": "use_consumable",
  "source": "static_delphi_review",
  "description": "Consumable use removes the item optimistically on the client; success finalizes with SM_EAT_OK.",
  "events": [
    {"seq": 1, "actor": "client", "action": "EatingItem = ItemArr[slot]; ItemArr[slot].S.Name = empty"},
    {"seq": 2, "direction": "client_to_server", "message": "CM_EAT", "recog": "MakeIndex", "body": "optional item name"},
    {"seq": 3, "actor": "server", "action": "ServerGetEatItem scans ItemList for MakeIndex"},
    {"seq": 4, "actor": "server", "action": "EatItem applies item effect"},
    {"seq": 5, "direction": "server_to_client", "message": "RM_HEALTHSPELLCHANGED", "condition": "instant HP/MP item"},
    {"seq": 6, "actor": "server", "action": "Dispose item pointer; ItemList.Delete(index)"},
    {"seq": 7, "direction": "server_to_client", "message": "RM_WEIGHTCHANGED"},
    {"seq": 8, "direction": "server_to_client", "message": "SM_EAT_OK"},
    {"seq": 9, "actor": "client", "action": "EatingItem.S.Name = empty; ArrangeItemBag"}
  ],
  "failure_events": [
    {"seq": 1, "direction": "server_to_client", "message": "SM_EAT_FAIL"},
    {"seq": 2, "actor": "client", "action": "AddItemBag(EatingItem); EatingItem.S.Name = empty"}
  ],
  "identity": "CM_EAT Recog is MakeIndex; name body is optional for server behavior"
}
