{
  "name": "take_on_item",
  "source": "static_delphi_review",
  "description": "Take-on uses MakeIndex and slot; client waits with WaitingUseItem.",
  "events": [
    {"seq": 1, "actor": "client", "action": "WaitingUseItem = MovingItem"},
    {"seq": 2, "direction": "client_to_server", "message": "CM_TAKEONITEM", "recog": "MakeIndex", "param": "equip slot", "body": "item name"},
    {"seq": 3, "actor": "server", "action": "find bag item by MakeIndex and name; remember internal bagindex"},
    {"seq": 4, "actor": "server", "action": "UseItems[slot] = item; DelItemIndex(bagindex)"},
    {"seq": 5, "direction": "server_to_client", "message": "SM_ADDITEM", "condition": "old equipped item was swapped to bag"},
    {"seq": 6, "direction": "server_to_client", "message": "SM_ABILITY"},
    {"seq": 7, "direction": "server_to_client", "message": "SM_SUBABILITY"},
    {"seq": 8, "direction": "server_to_client", "message": "SM_TAKEON_OK", "recog": "Feature"},
    {"seq": 9, "direction": "server_to_client", "message": "SM_FEATURECHANGED"}
  ],
  "failure_events": [
    {"seq": 1, "direction": "server_to_client", "message": "SM_TAKEON_FAIL"},
    {"seq": 2, "actor": "client", "action": "AddItemBag(WaitingUseItem)"}
  ],
  "identity": "CM_TAKEONITEM Recog is MakeIndex; Param is equip slot"
}
