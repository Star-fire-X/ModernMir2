{
  "name": "del_item",
  "source": "static_delphi_review",
  "description": "Visible delete sends a TClientItem; client deletes by identity.",
  "events": [
    {"seq": 1, "actor": "server", "action": "find item by MakeIndex and name, or internal bagindex helper"},
    {"seq": 2, "actor": "server", "action": "Dispose item pointer; ItemList.Delete(index)"},
    {"seq": 3, "actor": "server", "message": "RM_WEIGHTCHANGED"},
    {"seq": 4, "direction": "server_to_client", "message": "SM_DELITEM", "series": 1, "body": "TClientItem"},
    {"seq": 5, "actor": "client", "action": "ClientGetDelItem; DelItemBag(name, MakeIndex)"}
  ],
  "identity": "TClientItem.MakeIndex plus TClientItem.S.Name"
}
